theory J_T_2PKDP begin

// Function signature and definition of the equational theory E

builtins: xor
functions: dec/2, enc/2, fst/1, mac/2, pair/2, snd/1
equations:
    dec(enc(M, k), k) = M,
    fst(<x.1, x.2>) = x.1,
    snd(<x.1, x.2>) = x.2



lemma AUTO_typing [sources]:
  all-traces
  "(⊤) ∧
   (∀ x m #i.
     (AUTO_IN_1_1_AB3___VARIANT_16( m, x ) @ #i) ⇒
     (((∃ #j. (!KU( x ) @ #j) ∧ (#j < #i)) ∨
       (∃ #j. (AUTO_OUT_1_1_BA2( m ) @ #j) ∧ (#j < #i))) ∨
      (∃ #j. (AUTO_OUT_1_3_BA2( m ) @ #j) ∧ (#j < #i))))"
/*
guarded formula characterizing all counter-examples:
"∃ x m #i.
  (AUTO_IN_1_1_AB3___VARIANT_16( m, x ) @ #i)
 ∧
  (∀ #j. (!KU( x ) @ #j) ⇒ ¬(#j < #i)) ∧
  (∀ #j. (AUTO_OUT_1_1_BA2( m ) @ #j) ⇒ ¬(#j < #i)) ∧
  (∀ #j. (AUTO_OUT_1_3_BA2( m ) @ #j) ⇒ ¬(#j < #i))"
*/
induction
  case empty_trace
  by contradiction /* from formulas */
next
  case non_empty_trace
  simplify
  solve( (last(#i))  ∥
         (∃ #j. (!KU( x ) @ #j) ∧ (¬(last(#j))) ∧ (#j < #i))  ∥
         (∃ #j.
           (AUTO_OUT_1_1_BA2( enc(<na, x, x.1>, kab) ) @ #j)
          ∧
           (¬(last(#j))) ∧ (#j < #i))  ∥
         (∃ #j.
           (AUTO_OUT_1_3_BA2( enc(<na, x, x.1>, kab) ) @ #j)
          ∧
           (¬(last(#j))) ∧ (#j < #i)) )
    case case_1
    solve( AB1( $A, $B, na ) ▶₀ #i )
      case AB1
      solve( !SharedKey( $A, $B, kab ) ▶₂ #i )
        case setup
        solve( !KU( enc(<~na, x, x.1>, ~k) ) @ #vk.1 )
          case AB3___VARIANT_16_case_1
          by contradiction /* cyclic */
        next
          case AB3___VARIANT_16_case_2
          solve( (∃ #j. (!KU( z ) @ #j) ∧ (¬(last(#j))) ∧ (#j < #vr.3))  ∥
                 (∃ #j.
                   (AUTO_OUT_1_1_BA2( enc(<~na.1, z, x.2>, ~k.2) ) @ #j)
                  ∧
                   (¬(last(#j))) ∧ (#j < #vr.3))  ∥
                 (∃ #j.
                   (AUTO_OUT_1_3_BA2( enc(<~na.1, z, x.2>, ~k.2) ) @ #j)
                  ∧
                   (¬(last(#j))) ∧ (#j < #vr.3)) )
            case case_1
            by contradiction /* cyclic */
          next
            case case_2
            by contradiction /* impossible chain */
          next
            case case_3
            by contradiction /* impossible chain */
          qed
        next
          case BA2
          by contradiction /* from formulas */
        next
          case c_enc
          by contradiction /* from formulas */
        qed
      qed
    qed
  next
    case case_2
    by contradiction /* from formulas */
  next
    case case_3
    by contradiction /* from formulas */
  next
    case case_4
    by contradiction /* from formulas */
  qed
qed

rule (modulo E) setup:
   [ Fr( ~k ) ] --[ KeyGen( $A, $B ) ]-> [ !SharedKey( $A, $B, ~k ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) AB1:
   [ Fr( ~na ), !SharedKey( $A, $B, kab ) ]
  -->
   [ AB1( $A, $B, ~na ), Out( <$A, ~na> ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) BA2:
   [ Fr( ~kab1 ), In( <$A, na> ), !SharedKey( $A, $B, kab ) ]
  --[
  AUTO_OUT_1_1_BA2( enc(<na, ~kab1, $B>, kab) ),
  AUTO_OUT_1_3_BA2( enc(<na, ~kab1, $B>, kab) )
