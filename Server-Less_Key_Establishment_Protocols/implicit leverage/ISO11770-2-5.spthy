theory ISO11770_2_5 begin



/* 

 Protocol:

 1. A -> B: {ta}kab


*/
functions: enc/2, dec/2
equations: dec(enc(M,k), k) = M

rule setup:
  [ Fr(~k) ]
--[ KeyGen($A,$B) ]->
  [ !SharedKey($A, $B,~k) ]

/*
  rule reveal:
  [ !SharedKeyWithServer(X, k) ]
--[ Reveal(X,k),Init_once('1') ]->
  [ Out(k), Reveal(X,k)]
*/

rule AB1:
  [ Fr(~fab),Fr(~ta),!SharedKey($A, $B,kab)]
--[  ]->
  [ Out(enc(<<~ta,~ta>,<$B,~fab>>,kab)) ]

 rule BA2:
  [ Fr(~fba),Fr(~tb),!SharedKey($A, $B,kab)]
--[  ]->
  [ Out(enc(<<~tb,~tb>,<$A,~fba>>,kab)) ]


rule Guess_pw:
    [!SharedKey($A,$B,kab),Fr(~pw_guess)]
  --[Init_once('x')]->
    [Out(diff(~pw_guess,kab))]



restriction Init:
" 
   All #i #j x. Init_once(x)@i & Init_once(x)@j ==> #i=#j
"


restriction Verif:
"
    All x y #i. Eq(x,y) @ i ==> x = y
"
/*
restriction Init:
" 
   All #i #j x. Init_once(x)@i & Init_once(x)@j ==> #i=#j
"

restriction Neq:
"
    All x #i. Neq(x,x) @ i ==> F
"
#ifdef timethis
#endif
*/



end

