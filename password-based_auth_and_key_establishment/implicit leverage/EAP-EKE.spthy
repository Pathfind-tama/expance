theory EAPEKE
begin
builtins:	symmetric-encryption,diffie-hellman

rule Password_init:
    [ Fr(~pw) ]
  --[ Init_pw_once() ]->
    [ !Own(~pw) ]

rule C1:
let
	c = senc('g'^~rc,pw)
in
    [ !Own(pw),Fr(~rc)]
  --[ C1_do() ]->
    [ Out(c),C1_done(~rc,pw) ]

rule S1:
  let
    m = sdec(c,pw)
    key = m^~rs
  in
    [ !Own(pw),Fr(~rs),In(c),Fr(~nonce)]
  --[ S1_do() ]->
    [ Out(<senc('g'^~rs,pw),senc(~nonce,key)>),S1_done(key,~rs,pw,~nonce) ,!S1(key)]

rule C2:
  let
  	m1 = sdec(c1,pw)
  	key = m1^rc
  	s_nonce = sdec(c2,key)
  	c = senc(<s_nonce,~c_nonce>,key)
  in
    [ C1_done(rc,pw),In(<c1,c2>) ,Fr(~c_nonce)]
  --[ C2_do()]->
    [ Out(c) ,!C2(key)]


rule S3:
let
	ss_nonce = fst(sdec(c,key))
	c_nonce = snd(sdec(c,key))
	c = senc(c_nonce,key)
in
    [ In(c),S1_done(key,rs,pw,s_nonce)]
  --[ Eq(ss_nonce,s_nonce),S2() ]->
    [ Out(c)]


rule Guess_pw:
    [!Own(pw),Fr(~pw_guess)]
  --[Init_once('x')]->
    [Out(diff(~pw_guess,pw))]

rule RR:
    [In('g'^r)]
  --[]->
    [Out('DF')]

restriction Init:
" 
   All #i #j x. Init_once(x)@i & Init_once(x)@j ==> #i=#j
"

/*
rule Attack_test2:
    [ In(c),In(m),!C2(key) ]
  --[ Eq(c,senc(m,key)),Attack_suc() ]->
    [ ]


rule Attack_test3:
    [ In(c),In(m),!S1(key)]
  --[ Eq(c,senc(m,key)),Attack_suc() ]->
    [ ]*/

restriction Verif:
"
    All x y #i. Eq(x,y) @ i ==> x = y
"
restriction Init_1:
" 
   All #i #j. Init_pw_once()@i & Init_pw_once()@j ==> #i=#j
"
/*
lemma Exe:
exists-trace
"
	Ex x #i #j. User_response_done(x)@i & Finish(x)@j
"*/



end