theory Simplifie_GLNS_secret_public
begin
builtins:	asymmetric-encryption,xor,symmetric-encryption
functions: h/1

rule Password_init:
    [ Fr(~pwa),Fr(~pwb) ]
  --[ Init_pw_once() ]->
    [ !Own_AS(~pwa,$A,$S),!Own_BS(~pwb,$B,$S) ]

rule Register_pk:
	[ Fr(~ltk) ]
	-->
	[ !Ltk($A, ~ltk), !Pk($A, pk(~ltk)) ]

rule AS1s:
    [ !Own_AS(pwa,$A,$S)]
  --[ ]->
    [ Out(<$A,$B>),AS1($A,$B) ]


rule SA1s:
  let
    c1 = senc(<pk(ltkA) XOR $B>,pwa)
    c2 = senc(<pk(ltkB) XOR $A>,pwb)
  in
    [ !Own_AS(pwa,$A,$S),!Own_BS(pwb,$B,$S),!Ltk($S,ltkA),!Ltk($S,ltkB)
    ]
  --[ ]->
    [ Out(<c1,c2>),SA1($S,ltkA,ltkB) ]


rule AB1s:
  let
  	m1 = sdec(c1, pwa)
  	pkSA = m1 XOR $B
    c = aenc(~na,pkSA)
  in
    [ !Own_AS(pwa,$A,$S),Fr(~na),In(<c1,c2>),AS1($A,$B) ]
  --[ ]->
    [ Out(<$A,c,c2>),AB1($A,$B,~na,pkSA,pwa) ]

rule BS1s:
  let
    m2 = sdec(c2, pwb)
    pkSB = m2 XOR $A
    cs = aenc(~nb,pkSB)
  in
    [ !Own_BS(pwb,$B,$S),Fr(~nb),In(<$A,c,c2>) ]
  --[ ]->
    [ Out(<$A,$B,cs,c>),BS1($A,$B,~nb,pwb) ]


rule SB1s:
  let
  	nb = adec(cs,ltkB)
  	na = adec(c,ltkA)
    c1 = nb XOR senc(<nb XOR ~k>,pwb)
    c2 = na XOR senc(<na XOR ~k>,pwa)
  in
    [ !Own_AS(pwa,$A,$S),!Own_BS(pwb,$B,$S),SA1($S,ltkA,ltkB),Fr(~k),In(<$A,$B,cs,c>)
    ]
  --[ ]->
    [ Out(<c1,c2>) ]

rule BA1s:
  let
  	k = sdec(c1 XOR nb ,pwb) XOR nb
  in
    [ !Own_BS(pwb,$B,$S),BS1($A,$B,nb,pwb),In(<c1,c2>) ]
  --[  ]->
    [ Out(c2)]



rule Guess_pw:
    [Fr(~pw_guess),!Own_AS(pwa,$A,$S)]
  --[Init_once('x')]->
    [Out(diff(~pw_guess,pwa))]

rule RR:
    [In(pk(r))]
  --[]->
    [Out('DF1')]

restriction Verif:
"
    All x y #i. Eq(x,y) @ i ==> x = y
"
restriction Init:
" 
   All #i #j. Init_pw_once()@i & Init_pw_once()@j ==> #i=#j
"
/*
lemma Exe:
exists-trace
"
	Ex x #i #j. User_response_done(x)@i & Finish(x)@j
"*/



end