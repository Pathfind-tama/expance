theory Simplifie_GLNS_secret_public
begin
builtins:	asymmetric-encryption,xor
functions: h/1, enc/2, dec/2, prefix/1
equations: dec(enc(M,k), k) = M
         , prefix(enc(<X,Y>, k)) = enc(X, k)


rule Password_init:
    [ Fr(~pwa),Fr(~pwb) ]
  --[ Init_pw_once() ]->
    [ !Own_AS(~pwa,$A,$S),!Own_BS(~pwb,$B,$S) ]

rule Register_pk:
	[ Fr(~ltk) ]
	-->
	[ !Ltk($A, ~ltk), !Pk($A, pk(~ltk)) ]

rule AS1s:
    [ !Own_AS(pwa,$A,$S)]
  --[ ]->
    [ Out(<$A,$B>),AS1($A,$B) ]


rule SA1s:
  let
    c1 = enc(<pk(ltkA) XOR $B>,pwa)
    c2 = enc(<pk(ltkB) XOR $A>,pwb)
  in
    [ !Own_AS(pwa,$A,$S),!Own_BS(pwb,$B,$S),!Ltk($S,ltkA),!Ltk($S,ltkB)
    ]
  --[ ]->
    [ Out(<c1,c2>),SA1($S,ltkA,ltkB) ]


rule AB1s:
  let
  	m1 = dec(c1, pwa)
  	pkSA = m1 XOR $B
    c = aenc(~na,pkSA)
  in
    [ !Own_AS(pwa,$A,$S),Fr(~na),In(<c1,c2>),AS1($A,$B) ]
  --[ ]->
    [ Out(<$A,c,c2>),AB1($A,$B,~na,pkSA,pwa) ]

rule BS1s:
  let
    m2 = dec(c2, pwb)
    pkSB = m2 XOR $A
    cs = aenc(~nb,pkSB)
  in
    [ !Own_BS(pwb,$B,$S),Fr(~nb),In(<$A,c,c2>) ]
  --[ ]->
    [ Out(<$A,$B,cs,c>),BS1($A,$B,~nb,pwb) ]


rule SB1s:
  let
  	nb = adec(cs,ltkB)
  	na = adec(c,ltkA)
    c1 = nb XOR enc(<nb XOR ~k>,pwb)
    c2 = na XOR enc(<na XOR ~k>,pwa)
  in
    [ !Own_AS(pwa,$A,$S),!Own_BS(pwb,$B,$S),SA1($S,ltkA,ltkB),Fr(~k),In(<$A,$B,cs,c>)
    ]
  --[ ]->
    [ Out(<c1,c2>) ]

rule BA1s:
  let
  	k = dec(c1 XOR nb ,pwb) XOR nb
  in
    [ !Own_BS(pwb,$B,$S),BS1($A,$B,nb,pwb),In(<c1,c2>) ]
  --[  ]->
    [ Out(c2)]



rule Attack_test1:
    [ In(c),In(m),!Own_AS(pwa,$A,$S) ]
  --[ Eq(c,enc(m,pwa)),Attack_suc() ]->
    [ ]

rule Attack_test2:
    [ In(c),In(m),!Own_BS(pwb,$B,$S)]
  --[ Eq(c,enc(m,pwb)),Attack_suc() ]->
    [ ]



restriction Verif:
"
    All x y #i. Eq(x,y) @ i ==> x = y
"
restriction Init:
" 
   All #i #j. Init_pw_once()@i & Init_pw_once()@j ==> #i=#j
"
/*
lemma Exe:
exists-trace
"
	Ex x #i #j. User_response_done(x)@i & Finish(x)@j
"*/


lemma Test:
exists-trace
"
	Ex #j. Attack_suc()@j
"

end