theory CHAPv1 begin

// Function signature and definition of the equational theory E

functions: fst/1, h/1, pair/2, sdec/2, senc/2, snd/1
equations:
    fst(<x.1, x.2>) = x.1,
    sdec(senc(x.1, x.2), x.2) = x.1,
    snd(<x.1, x.2>) = x.2



rule (modulo E) Password_init:
   [ Fr( ~pw ) ] --[ Init_pw_once( ) ]-> [ !Own( ~pw ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) Server_challenge:
   [ !Own( pw ), Fr( ~random_challenge ) ]
  --[ S1( ) ]->
   [
   Out( <'01', ~random_challenge> ),
   Server_challenge_done( ~random_challenge, pw )
   ]

  /* has exactly the trivial AC variant */

rule (modulo E) User_response:
   [ !Own( pw ), In( <'01', random_challenge> ) ]
  --[ U1( ), User_response_done( pw ) ]->
   [ Out( <'02', senc(random_challenge, h(pw))> ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) Server_verify:
   [ In( <'02', c> ), Server_challenge_done( random_challenge, pw ) ]
  --[ Eq( c, senc(random_challenge, h(pw)) ), Finish( pw ) ]->
   [ ]

  /* has exactly the trivial AC variant */

rule (modulo E) Attack_test:
   [ In( c ), In( m ), !Own( pw ) ]
  --[ Eq( c, senc(m, h(pw)) ), Attack_suc( ) ]->
   [ ]

  /* has exactly the trivial AC variant */

restriction Verif:
  "∀ x y #i. (Eq( x, y ) @ #i) ⇒ (x = y)"
  // safety formula

restriction Init:
  "∀ #i #j. ((Init_pw_once( ) @ #i) ∧ (Init_pw_once( ) @ #j)) ⇒ (#i = #j)"
  // safety formula

lemma Test:
  exists-trace "∃ #j. Attack_suc( ) @ #j"
/*
guarded formula characterizing all satisfying traces:
"∃ #j. (Attack_suc( ) @ #j)"
*/
simplify
solve( !Own( pw ) ▶₂ #j )
  case Password_init
  solve( !KU( senc(m, h(~pw)) ) @ #vk )
    case User_response
    SOLVED // trace found
  qed
qed

/* All well-formedness checks were successful. */

end

