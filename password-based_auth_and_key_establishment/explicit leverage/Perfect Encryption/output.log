theory Simplifie_GLNS_secret_public begin

// Function signature and definition of the equational theory E

functions: adec/2, aenc/2, fst/1, h/1, pair/2, pk/1, sdec/2, senc/2,
           snd/1
equations:
    adec(aenc(x.1, pk(x.2)), x.2) = x.1,
    fst(<x.1, x.2>) = x.1,
    sdec(senc(x.1, x.2), x.2) = x.1,
    snd(<x.1, x.2>) = x.2



rule (modulo E) Password_init:
   [ Fr( ~pwa ), Fr( ~pwb ) ]
  --[ Init_pw_once( ) ]->
   [ !Own_AS( ~pwa, $A, $S ), !Own_BS( ~pwb, $B, $S ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) Register_pk:
   [ Fr( ~ltk ) ] --> [ !Ltk( $A, ~ltk ), !Pk( $A, pk(~ltk) ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) AB1s:
   [ !Own_AS( pwa, $A, $S ), !Pk( $A, pkA ), Fr( ~na ) ]
  -->
   [ Out( <senc(pkA, pwa), ~na> ), AB1( $A, $B, ~na, pkA ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) BS1s:
   [ !Own_BS( pwb, $B, $S ), !Pk( $B, pkB ), In( <na, c> ), Fr( ~nb ) ]
  -->
   [ Out( <na, c, ~nb, senc(pkB, pwb)> ), BS1( $A, $B, na, ~nb, pkB ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) SB1s:
   [
   !Own_AS( pwa, $A, $S ), !Own_BS( pwb, $B, $S ), Fr( ~k ),
   In( <na, c, nb, c11> ), Fr( ~c1 ), Fr( ~c2 )
   ]
  -->
   [
   Out( <aenc(<$A, $B, ~c1, ~k, senc(na, pwa)>, sdec(c, pwa)), 
         aenc(<$B, $A, ~c2, ~k, senc(nb, pwb)>, sdec(c11, pwb))>
   ),
   !Save( ~k )
   ]

  /*
  rule (modulo AC) SB1s:
     [
     !Own_AS( pwa, $A, $S ), !Own_BS( pwb, $B, $S ), Fr( ~k ),
     In( <na, c, nb, c11> ), Fr( ~c1 ), Fr( ~c2 )
     ]
    -->
     [
     Out( <aenc(<$A, $B, ~c1, ~k, senc(na, pwa)>, z), 
           aenc(<$B, $A, ~c2, ~k, senc(nb, pwb)>, z.1)>
     ),
     !Save( ~k )
     ]
    variants (modulo AC)
    1. c     = c.15
       c11   = c11.15
       pwa   = pwa.15
       pwb   = pwb.15
       z     = sdec(c.15, pwa.15)
       z.1   = sdec(c11.15, pwb.15)
    
    2. c     = c.17
       c11   = senc(x.15, x.16)
       pwa   = pwa.17
       pwb   = x.16
       z     = sdec(c.17, pwa.17)
       z.1   = x.15
    
    3. c     = senc(x.15, x.16)
       c11   = c11.17
       pwa   = x.16
       pwb   = pwb.17
       z     = x.15
       z.1   = sdec(c11.17, pwb.17)
    
    4. c     = senc(x.15, x.16)
       c11   = senc(x.17, x.18)
       pwa   = x.16
       pwb   = x.18
       z     = x.15
       z.1   = x.17
  */

rule (modulo E) BA1s:
   [
   !Own_BS( pwb, $B, $S ), BS1( $A, $B, na, nb, pkB ),
   In( <sbc1, aenc(<$B, $A, c2, k, senc(nbs, pwb)>, pk(ltkB))> ),
   !Ltk( $B, ltkB )
   ]
  --[ Eq( pk(ltkB), pkB ), Eq( nbs, nb ) ]->
   [ Out( <sbc1, senc(na, k), nb> ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) AB2s:
   [
   !Own_AS( pwa, $A, $S ), AB1( $A, $B, na, pkA ), !Ltk( $A, ltkA ),
   In( <aenc(<$A, $B, c1, k, senc(nas, pwa)>, pk(ltkA)), cna, nb> )
   ]
  --[ Eq( pk(ltkA), pkA ), Eq( nas, na ), Eq( sdec(cna, k), na ) ]->
   [ Out( senc(nb, k) ) ]

  /*
  rule (modulo AC) AB2s:
     [
     !Own_AS( pwa, $A, $S ), AB1( $A, $B, na, pkA ), !Ltk( $A, ltkA ),
     In( <aenc(<$A, $B, c1, k, senc(nas, pwa)>, pk(ltkA)), cna, nb> )
     ]
    --[ Eq( pk(ltkA), pkA ), Eq( nas, na ), Eq( z, na ) ]->
     [ Out( senc(nb, k) ) ]
    variants (modulo AC)
    1. cna   = cna.14
       k     = k.14
       z     = sdec(cna.14, k.14)
    
    2. cna   = senc(x.14, x.15)
       k     = x.15
       z     = x.14
  */

rule (modulo E) Attack_test1:
   [ In( c ), In( m ), !Own_AS( pwa, $A, $S ) ]
  --[ Eq( c, senc(m, pwa) ), Attack_suc( ) ]->
   [ ]

  /* has exactly the trivial AC variant */

rule (modulo E) Attack_test2:
   [ In( c ), In( m ), !Own_BS( pwb, $B, $S ) ]
  --[ Eq( c, senc(m, pwb) ), Attack_suc( ) ]->
   [ ]

