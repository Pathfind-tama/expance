        kbs   = x.11
        z     = snd(fst(x.10))
        z.1   = fst(x.10)
        z.2   = x.12
    
     9. c1    = enc(<x.10, x.11>, x.12)
        c2    = c2.13
        kbs   = x.12
        z     = snd(x.10)
        z.1   = x.10
        z.2   = (c2.13⊕snd(x.10))
    
    10. c1    = enc(<x.10, x.11>, x.12)
        c2    = snd(x.10)
        kbs   = x.12
        z     = snd(x.10)
        z.1   = x.10
        z.2   = zero
    
    11. c1    = enc(<x.10, x.11>, x.12)
        c2    = zero
        kbs   = x.12
        z     = snd(x.10)
        z.1   = x.10
        z.2   = snd(x.10)
    
    12. c1    = enc(<x.10, x.11>, x.12)
        c2    = (x.13⊕snd(x.10))
        kbs   = x.12
        z     = snd(x.10)
        z.1   = x.10
        z.2   = x.13
    
    13. c1    = enc(<<x.10, x.11>, x.12>, x.13)
        c2    = x.11
        kbs   = x.13
        z     = x.11
        z.1   = <x.10, x.11>
