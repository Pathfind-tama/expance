     6. c1    = enc(x.10, x.11)
        c2    = snd(fst(x.10))
        kbs   = x.11
        z     = snd(fst(x.10))
        z.1   = fst(x.10)
        z.2   = zero
    
     7. c1    = enc(x.10, x.11)
        c2    = zero
        kbs   = x.11
        z     = snd(fst(x.10))
        z.1   = fst(x.10)
        z.2   = snd(fst(x.10))
    
     8. c1    = enc(x.10, x.11)
