// Function signature and definition of the equational theory E

functions: dec/2, enc/2, fst/1, pair/2, snd/1
equations:
    dec(enc(M, k), k) = M,
    fst(<x.1, x.2>) = x.1,
    snd(<x.1, x.2>) = x.2



rule (modulo E) setup:
   [ Fr( ~k ) ] --[ KeyGen( $A ) ]-> [ !SharedKeyWithServer( $A, ~k ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) AB1:
   [ Fr( ~na ), !SharedKeyWithServer( $A, kas ) ]
  -->
   [ AB1( $A, $B, ~na ), Out( ~na ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) BA2:
   [ In( na ), Fr( ~nb ), !SharedKeyWithServer( $B, kbs ) ]
  -->
   [ BA2( $A, $B, na, ~nb ), Out( ~nb ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) AB3:
   [ AB1( $A, $B, na ), In( nb ), !SharedKeyWithServer( $A, kas ) ]
  -->
   [ AB3( $A, $B, na, nb ), Out( enc(<$A, $B, na, nb>, kas) ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) BS4:
   [
