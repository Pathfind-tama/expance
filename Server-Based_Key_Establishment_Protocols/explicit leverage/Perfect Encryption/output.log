// Function signature and definition of the equational theory E

builtins: xor
functions: dec/2, enc/2, fst/1, pair/2, snd/1
equations:
    dec(enc(M, k), k) = M,
    fst(<x.1, x.2>) = x.1,
    snd(<x.1, x.2>) = x.2



rule (modulo E) setup:
   [ Fr( ~k ) ] --[ KeyGen( $A ) ]-> [ !SharedKeyWithServer( $A, ~k ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) AB1:
   [ Fr( ~na ), Fr( ~na1 ), !SharedKeyWithServer( $A, kas ) ]
  -->
   [ AS1( $A, $B, ~na, ~na1 ), Out( <$A, ~na, ~na1> ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) BS2:
   [ In( <$A, na, na1> ), Fr( ~nb ), !SharedKeyWithServer( $B, kbs ) ]
  -->
   [ BS2( $A, $B, na, na1, ~nb ), Out( <$A, $B, na, ~nb> ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) SB3:
   [
   In( <$A, $B, na, nb> ), Fr( ~kab ), !SharedKeyWithServer( $A, kas ),
   !SharedKeyWithServer( $B, kbs )
   ]
