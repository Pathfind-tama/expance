rule (modulo E) AB1:
   [ AS3( $A, $B, na, kab ), !SharedKeyWithServer( $A, kas ), Fr( ~na1 ) ]
  -->
   [ Out( <$A, ~na1> ), AB1( $A, $B, na, kab, ~na1 ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) BA2:
   [
   In( <$A, na1> ), Fr( ~nb1 ), BS3( $B, $A, nb, kab ),
   !SharedKeyWithServer( $B, kbs )
   ]
  -->
   [ Out( <enc(<na1, ~nb1, $B>, kab), ~nb1> ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) AB3:
   [
   In( <c, nb1> ), AB1( $A, $B, na, kab, na1 ),
   !SharedKeyWithServer( $A, kas )
   ]
  --[ Eq( nb1, snd(fst(dec(c, kab))) ), Eq( na1, fst(dec(c, kab)) ) ]->
   [ Out( enc(<na1, nb1, $B>, kab) ) ]

  /*
  rule (modulo AC) AB3:
     [
     In( <c, nb1> ), AB1( $A, $B, na, kab, na1 ),
     !SharedKeyWithServer( $A, kas )
     ]
    --[ Eq( nb1, z ), Eq( na1, z.1 ) ]->
     [ Out( enc(<na1, nb1, $B>, kab) ) ]
    variants (modulo AC)
    1. c     = c.11
       kab   = kab.11
       z     = snd(fst(dec(c.11, kab.11)))
       z.1   = fst(dec(c.11, kab.11))
    
    2. c     = enc(x.11, x.12)
       kab   = x.12
       z     = snd(fst(x.11))
       z.1   = fst(x.11)
    
    3. c     = enc(<x.11, x.12>, x.13)
       kab   = x.13
       z     = snd(x.11)
       z.1   = x.11
    
    4. c     = enc(<<x.11, x.12>, x.13>, x.14)
       kab   = x.14
       z     = x.12
       z.1   = <x.11, x.12>
  */

rule (modulo E) Attack_test:
   [ In( c ), In( m ), !SharedKeyWithServer( $B, kbs ) ]
  --[ Eq( c, enc(m, kbs) ), Attack_suc( ) ]->
   [ ]

  /* has exactly the trivial AC variant */

restriction Verif:
  "∀ x y #i. (Eq( x, y ) @ #i) ⇒ (x = y)"
  // safety formula

lemma Test:
  exists-trace "∃ #j. Attack_suc( ) @ #j"
/*
guarded formula characterizing all satisfying traces:
"∃ #j. (Attack_suc( ) @ #j)"
*/
simplify
solve( !SharedKeyWithServer( $B, kbs ) ▶₂ #j )
  case setup
  solve( !KU( enc(m, ~k) ) @ #vk )
    case AS3
    solve( !KU( enc(<~na, x>, ~k) ) @ #vk.3 )
      case AS3
      by contradiction /* cyclic */
    next
      case SA2_case_1
      solve( !KU( (enc(enc(<~na, ~kab, $B.2>, ~k), ~k)⊕snd(~na)) ) @ #vk.4 )
        case c_xor
        solve( !KU( snd(~na) ) @ #vk.9 )
          case AS3
          by contradiction /* cyclic */
        next
          case c_snd
          solve( !KU( enc(enc(<~na, ~kab, $B.1>, ~k), ~k) ) @ #vk.12 )
            case SA2
            solve( !KU( ~kab ) @ #vk.13 )
              case SA2_case_1
              by solve( !KU( ~k ) @ #vk.14 )
            next
              case SA2_case_2
              by contradiction /* cyclic */
            next
              case SB2_case_1
              by solve( !KU( ~k.2 ) @ #vk.17 )
            next
              case SB2_case_2
              solve( !KU( enc(enc(<nb, ~kab, $B>, ~k.2), ~k.2) ) @ #vk.17 )
                case SB2
                by contradiction /* cyclic */
              next
                case c_enc
                by solve( !KU( ~k.1 ) @ #vk.19 )
              qed
            qed
          next
            case c_enc
            by solve( !KU( ~k ) @ #vk.13 )
          qed
        qed
      next
        case coerce
        solve( !KD( (enc(enc(<~na, ~kab, $B.1>, ~k), ~k)⊕snd(~na)) ) ▶₀ #vk.2 )
          case AB1
          by contradiction /* impossible chain */
        next
          case AB3
          solve( (#vl.2, 0) ~~> (#vk.2, 0) )
            case d_0_dec
            solve( (#vr.7, 0) ~~> (#vk.2, 0) )
              case d_0_fst
              solve( AB1( $A, $B.3, na.1, kab.1, na1 ) ▶₁ #vr.6 )
                case AB1
                by contradiction /* impossible chain */
              qed
            next
              case d_0_snd
              solve( (#vr.8, 0) ~~> (#vk.2, 0) )
                case d_0_fst
                by contradiction /* cyclic */
              next
                case d_0_snd
                by contradiction /* forbidden KD-fact */
              qed
            qed
          qed
        next
          case AS1
          by contradiction /* impossible chain */
        next
          case AS3
          solve( (#vl.2, 0) ~~> (#vk.2, 0) )
            case d_0_dec
            solve( (#vr.7, 0) ~~> (#vk.2, 0) )
              case d_0_fst
              solve( AS1( $A, $B.3, na.1 ) ▶₀ #vr.6 )
                case AS1
                by contradiction /* impossible chain */
              qed
            next
              case d_0_snd
              solve( (#vr.8, 0) ~~> (#vk.2, 0) )
                case d_0_fst
                solve( AS1( $A, $B.3, na.1 ) ▶₀ #vr.6 )
                  case AS1
                  by contradiction /* impossible chain */
                qed
              next
                case d_0_snd
                by contradiction /* forbidden KD-fact */
              qed
            qed
          qed
        next
          case BA2
          solve( (#vl.2, 0) ~~> (#vk.2, 0) )
            case d_0_fst
            solve( (#vr.7, 0) ~~> (#vk.2, 0) )
              case d_0_dec
              solve( (#vr.8, 0) ~~> (#vk.2, 0) )
                case d_0_fst
                by contradiction /* cyclic */
              next
                case d_0_snd
                by contradiction /* impossible chain */
              qed
            qed
          next
            case d_0_snd
            by contradiction /* impossible chain */
          qed
        next
          case BS1
          by contradiction /* impossible chain */
        next
          case BS3
          solve( (#vl.2, 0) ~~> (#vk.2, 0) )
            case d_0_dec
            solve( (#vr.7, 0) ~~> (#vk.2, 0) )
              case d_0_fst
              solve( BS1( $B.3, $A, nb ) ▶₀ #vr.6 )
                case BS1
                by contradiction /* impossible chain */
              qed
            next
              case d_0_snd
              solve( (#vr.8, 0) ~~> (#vk.2, 0) )
                case d_0_fst
                solve( BS1( $B.3, $A, nb ) ▶₀ #vr.6 )
                  case BS1
                  by contradiction /* impossible chain */
                qed
              next
                case d_0_snd
                by contradiction /* forbidden KD-fact */
              qed
            qed
          qed
        next
          case SA2
          solve( (#vl.2, 0) ~~> (#vk.2, 0) )
            case d_0_fst
            solve( (#vr.7, 0) ~~> (#vk.2, 0) )
              case d_0_dec
              solve( (#vr.8, 0) ~~> (#vk.2, 0) )
                case d_0_fst
                by contradiction /* cyclic */
              next
                case d_0_snd
                by contradiction /* impossible chain */
              qed
            qed
          next
            case d_0_snd
            solve( (#vr.7, 0) ~~> (#vk.2, 0) )
              case d_xor_case_1
              by solve( (#vr.8, 0) ~~> (#vk.2, 0) )
            next
              case d_xor_case_2
              solve( (#vr.8, 0) ~~> (#vk.2, 0) )
                case Xor
                solve( !KU( snd(~na) ) @ #vk.9 )
                  case AS3
                  by solve( !KU( ~k ) @ #vk.13 )
                next
                  case c_snd
                  solve( !KU( (~kab⊕snd(~na)) ) @ #vk.12 )
                    case c_xor
                    solve( !KU( ~kab ) @ #vk.13 )
                      case SA2_case_1
                      by solve( !KU( ~k ) @ #vk.14 )
                    next
                      case SA2_case_2
                      solve( !KU( enc(enc(<~na, ~kab, $B>, ~k), ~k) ) @ #vk.14 )
                        case SA2
                        by contradiction /* cyclic */
                      next
                        case c_enc
                        by solve( !KU( ~k ) @ #vk.15 )
                      qed
                    next
                      case SB2_case_1
                      by solve( !KU( ~k.2 ) @ #vk.17 )
                    next
                      case SB2_case_2
                      solve( !KU( enc(enc(<nb, ~kab, $A>, ~k.2), ~k.2) ) @ #vk.17 )
                        case SB2
                        by contradiction /* cyclic */
                      next
                        case c_enc
                        by solve( !KU( ~k.1 ) @ #vk.19 )
                      qed
                    qed
                  next
                    case coerce
                    solve( !KD( (~kab⊕snd(~na)) ) ▶₀ #vk.4 )
                      case AB1
                      by contradiction /* impossible chain */
                    next
                      case AB3
                      solve( (#vl.2, 0) ~~> (#vk.4, 0) )
                        case d_0_dec
                        solve( (#vr.9, 0) ~~> (#vk.4, 0) )
                          case d_0_fst
                          solve( AB1( $A.1, $B.2, na.1, kab.1, na1 ) ▶₁ #vr.8 )
                            case AB1
                            by contradiction /* impossible chain */
                          qed
                        next
                          case d_0_snd
                          solve( (#vr.10, 0) ~~> (#vk.4, 0) )
                            case d_0_fst
                            by contradiction /* cyclic */
                          next
                            case d_0_snd
                            by contradiction /* forbidden KD-fact */
                          qed
                        qed
                      qed
                    next
                      case AS1
                      by contradiction /* impossible chain */
                    next
                      case AS3
                      solve( (#vl.2, 0) ~~> (#vk.4, 0) )
                        case d_0_dec
                        solve( (#vr.9, 0) ~~> (#vk.4, 0) )
                          case d_0_fst
                          solve( AS1( $A.1, $B.2, na.1 ) ▶₀ #vr.8 )
                            case AS1
                            by contradiction /* impossible chain */
                          qed
                        next
                          case d_0_snd
                          solve( (#vr.10, 0) ~~> (#vk.4, 0) )
                            case d_0_fst
                            solve( AS1( $A.1, $B.2, na.1 ) ▶₀ #vr.8 )
                              case AS1
                              by contradiction /* impossible chain */
                            qed
                          next
                            case d_0_snd
                            by contradiction /* forbidden KD-fact */
                          qed
                        qed
                      qed
