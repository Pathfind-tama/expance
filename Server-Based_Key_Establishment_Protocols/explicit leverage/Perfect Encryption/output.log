theory Yahalom_Burrows begin

// Function signature and definition of the equational theory E

builtins: xor
functions: dec/2, enc/2, fst/1, pair/2, snd/1
equations:
    dec(enc(M, k), k) = M,
    fst(<x.1, x.2>) = x.1,
    snd(<x.1, x.2>) = x.2



rule (modulo E) setup:
   [ Fr( ~k ) ] --[ KeyGen( $A ) ]-> [ !SharedKeyWithServer( $A, ~k ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) AS1:
   [ Fr( ~na ), !SharedKeyWithServer( $A, kas ) ]
  -->
   [ AS1( $A, $B, ~na ), Out( <$A, $B, ~na> ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) SA2:
   [ In( <$A, $B, na> ), Fr( ~kab ), !SharedKeyWithServer( $A, kas ) ]
  -->
   [
   SA2( $A, $B, ~kab ),
   Out( <enc(<na, ~kab, $B>, kas), (~kab⊕enc(enc(<na, ~kab, $B>, kas), kas))
        >
   )
   ]

  /* has exactly the trivial AC variant */

rule (modulo E) AS3:
   [ AS1( $A, $B, na ), In( <c1, c2> ), !SharedKeyWithServer( $A, kas ) ]
  --[
  Eq( fst(dec(c1, kas)), na ),
  Eq( (c2⊕snd(fst(dec(c1, kas)))), enc(c1, kas) )
  ]->
   [
   Out( enc(<na, snd(fst(dec(c1, kas))), $A>, kas) ),
   AS3( $A, $B, na, snd(fst(dec(c1, kas))) )
   ]

  /*
  rule (modulo AC) AS3:
     [ AS1( $A, $B, na ), In( <c1, c2> ), !SharedKeyWithServer( $A, kas ) ]
    --[ Eq( z.1, na ), Eq( z.2, enc(c1, kas) ) ]->
     [ Out( enc(<na, z, $A>, kas) ), AS3( $A, $B, na, z ) ]
    variants (modulo AC)
     1. c1    = c1.10
        c2    = c2.10
        kas   = kas.10
        z     = snd(fst(dec(c1.10, kas.10)))
        z.1   = fst(dec(c1.10, kas.10))
        z.2   = (c2.10⊕snd(fst(dec(c1.10, kas.10))))
    
     2. c1    = c1.10
        c2    = zero
        kas   = kas.10
        z     = snd(fst(dec(c1.10, kas.10)))
        z.1   = fst(dec(c1.10, kas.10))
        z.2   = snd(fst(dec(c1.10, kas.10)))
    
     3. c1    = x.10
        c2    = snd(fst(dec(x.10, x.11)))
        kas   = x.11
        z     = snd(fst(dec(x.10, x.11)))
        z.1   = fst(dec(x.10, x.11))
        z.2   = zero
    
     4. c1    = x.10
        c2    = (x.11⊕snd(fst(dec(x.10, x.12))))
        kas   = x.12
        z     = snd(fst(dec(x.10, x.12)))
        z.1   = fst(dec(x.10, x.12))
        z.2   = x.11
    
     5. c1    = enc(x.10, x.11)
        c2    = c2.12
        kas   = x.11
        z     = snd(fst(x.10))
        z.1   = fst(x.10)
        z.2   = (c2.12⊕snd(fst(x.10)))
    
     6. c1    = enc(x.10, x.11)
        c2    = snd(fst(x.10))
        kas   = x.11
        z     = snd(fst(x.10))
        z.1   = fst(x.10)
        z.2   = zero
    
     7. c1    = enc(x.10, x.11)
        c2    = zero
        kas   = x.11
        z     = snd(fst(x.10))
        z.1   = fst(x.10)
        z.2   = snd(fst(x.10))
    
     8. c1    = enc(x.10, x.11)
        c2    = (x.12⊕snd(fst(x.10)))
        kas   = x.11
        z     = snd(fst(x.10))
        z.1   = fst(x.10)
        z.2   = x.12
    
     9. c1    = enc(<x.10, x.11>, x.12)
        c2    = c2.13
        kas   = x.12
        z     = snd(x.10)
        z.1   = x.10
        z.2   = (c2.13⊕snd(x.10))
    
    10. c1    = enc(<x.10, x.11>, x.12)
        c2    = snd(x.10)
        kas   = x.12
        z     = snd(x.10)
        z.1   = x.10
        z.2   = zero
    
    11. c1    = enc(<x.10, x.11>, x.12)
        c2    = zero
        kas   = x.12
        z     = snd(x.10)
        z.1   = x.10
        z.2   = snd(x.10)
    
    12. c1    = enc(<x.10, x.11>, x.12)
        c2    = (x.13⊕snd(x.10))
        kas   = x.12
        z     = snd(x.10)
        z.1   = x.10
        z.2   = x.13
    
    13. c1    = enc(<<x.10, x.11>, x.12>, x.13)
        c2    = x.11
        kas   = x.13
        z     = x.11
        z.1   = <x.10, x.11>
        z.2   = zero
    
    14. c1    = enc(<<x.10, x.11>, x.12>, x.13)
        c2    = c2.14
        kas   = x.13
        z     = x.11
        z.1   = <x.10, x.11>
        z.2   = (x.11⊕c2.14)
    
    15. c1    = enc(<<x.10, x.11>, x.12>, x.13)
        c2    = zero
        kas   = x.13
        z     = x.11
        z.1   = <x.10, x.11>
        z.2   = x.11
    
    16. c1    = enc(<<x.10, x.11>, x.12>, x.13)
        c2    = (x.11⊕x.14)
        kas   = x.13
        z     = x.11
        z.1   = <x.10, x.11>
        z.2   = x.14
    
    17. c1    = enc(<<x.10, zero>, x.11>, x.12)
        c2    = c2.13
        kas   = x.12
        z     = zero
        z.1   = <x.10, zero>
        z.2   = c2.13
    
    18. c1    = enc(<<x.10, (x.11⊕x.12)>, x.13>, x.14)
        c2    = x.11
        kas   = x.14
        z     = (x.11⊕x.12)
        z.1   = <x.10, (x.11⊕x.12)>
        z.2   = x.12
    
    19. c1    = enc(<<x.10, (x.11⊕x.12)>, x.13>, x.14)
        c2    = (x.11⊕x.15)
        kas   = x.14
        z     = (x.11⊕x.12)
        z.1   = <x.10, (x.11⊕x.12)>
        z.2   = (x.12⊕x.15)
  */

rule (modulo E) BS1:
   [ Fr( ~nb ), !SharedKeyWithServer( $B, kas ) ]
  -->
   [ BS1( $B, $A, ~nb ), Out( <$B, $A, ~nb> ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) SB2:
   [ In( <$A, $B, nb> ), !SharedKeyWithServer( $B, kbs ), SA2( $A, $B, kab )
   ]
  -->
   [
   Out( <enc(<nb, kab, $A>, kbs), (kab⊕enc(enc(<nb, kab, $A>, kbs), kbs))> )
   ]

  /*
  rule (modulo AC) SB2:
     [ In( <$A, $B, nb> ), !SharedKeyWithServer( $B, kbs ), SA2( $A, $B, kab )
     ]
    -->
     [ Out( <enc(<nb, kab, $A>, kbs), z> ) ]
    variants (modulo AC)
    1. $A    = $A.7
       kab   = kab.7
       kbs   = kbs.7
       nb    = nb.7
       z     = (kab.7⊕enc(enc(<nb.7, kab.7, $A.7>, kbs.7), kbs.7))
    
    2. $A    = $A.7
       kab   = zero
       kbs   = kbs.7
       nb    = nb.7
       z     = enc(enc(<nb.7, zero, $A.7>, kbs.7), kbs.7)
  */

rule (modulo E) BS3:
   [ BS1( $B, $A, nb ), In( <c1, c2> ), !SharedKeyWithServer( $B, kbs ) ]
  --[
  Eq( fst(dec(c1, kbs)), nb ),
  Eq( (c2⊕snd(fst(dec(c1, kbs)))), enc(c1, kbs) )
  ]->
   [
   Out( enc(<nb, snd(fst(dec(c1, kbs))), $B>, kbs) ),
