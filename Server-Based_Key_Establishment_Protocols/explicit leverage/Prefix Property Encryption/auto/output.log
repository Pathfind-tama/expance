theory Gongtime begin

// Function signature and definition of the equational theory E

functions: Mac/3, dec/2, enc/2, fst/1, pair/2, prefix/1, snd/1
equations:
    dec(enc(M, k), k) = M,
    fst(<x.1, x.2>) = x.1,
    prefix(enc(<X, Y>, k)) = enc(X, k),
    snd(<x.1, x.2>) = x.2



rule (modulo E) setup:
   [ Fr( ~k ) ] --[ KeyGen( $A ) ]-> [ !SharedKeyWithServer( $A, ~k ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) A2B1:
   [ !SharedKeyWithServer( $A, kas ), Fr( ~na ) ]
  -->
   [ InitiatorRequestedA( $A, $B, ~na ), Out( <$A, $B, ~na> ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) B2S1:
   [
   In( <$A, $B, na> ), !SharedKeyWithServer( $B, kbs ), Fr( ~k2 ), Fr( ~nb )
   ]
  -->
   [
   InitiatorRequestedB( $A, $B, ~k2, ~nb ),
   Out( <$A, $B, ~nb, enc(<<<<<$B, $S>, $B>, ~k2>, $A>, na>, kbs)> )
   ]

  /* has exactly the trivial AC variant */

rule (modulo E) Attack_test:
   [ In( c ), In( m ), !SharedKeyWithServer( $A, kas ) ]
  --[ Eq( c, enc(m, kas) ), Attack_suc( ) ]->
   [ ]

  /* has exactly the trivial AC variant */

rule (modulo E) Attack_test2:
   [ In( c ), In( m ), !SharedKeyWithServer( $B, kbs ) ]
  --[ Eq( c, enc(m, kbs) ), Attack_suc( ) ]->
   [ ]

  /* has exactly the trivial AC variant */

restriction Verif:
  "∀ x y #i. (Eq( x, y ) @ #i) ⇒ (x = y)"
  // safety formula

lemma Test:
  exists-trace "∃ #j. Attack_suc( ) @ #j"
/*
guarded formula characterizing all satisfying traces:
"∃ #j. (Attack_suc( ) @ #j)"
*/
simplify
solve( Attack_suc( ) @ #j )
  case Attack_test
