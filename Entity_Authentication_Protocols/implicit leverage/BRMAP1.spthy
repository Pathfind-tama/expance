theory MAP1 begin



/* 

 Protocol:

 1. A -> B: {ta}kab


*/
functions: enc/2, dec/2
equations: dec(enc(M,k), k) = M

rule setup:
  [ Fr(~k) ]
--[ KeyGen($A,$B) ]->
  [ !SharedKey($A, $B,~k) ]

/*
  rule reveal:
  [ !SharedKeyWithServer(X, k) ]
--[ Reveal(X,k),Init_once('1') ]->
  [ Out(k), Reveal(X,k)]
*/
rule AB1:
  [ Fr(~na),!SharedKey($A, $B,kab)]
--[  ]->
  [ Out(~na) ,AB1($A,$B,~na)]


rule BA2:
let
	c=enc(<$B,<$A,<na,~nb>>>,kab)
in
  [ Fr(~nb),In(na),!SharedKey($A, $B,kab)]
--[  ]->
  [ Out(<~nb,c>),BA2($A, $B,~nb)]

 rule AB3:
 let
 	m=dec(c,kab)
 	nas=fst(snd(snd(m)))
 	nbs=snd(snd(snd(m)))
 	c1=enc(<$A,nb>,kab)
 in
  [ In(<nb,c>),!SharedKey($A, $B,kab),AB1($A,$B,na)]
--[  Eq(nas,na),Eq(nbs,nb)]->
  [ Out(c1) ]

rule Guess_pw:
    [!SharedKey($A,$B,kab),Fr(~pw_guess)]
  --[Init_once('x')]->
    [Out(diff(~pw_guess,kab))]
/*
rule RR:
    [In(<'g'^r,r>)]
  --[]->
    [Out('DF1')]*/

restriction Init:
" 
   All #i #j x. Init_once(x)@i & Init_once(x)@j ==> #i=#j
"


restriction Verif:
"
    All x y #i. Eq(x,y) @ i ==> x = y
"
/*
restriction Init:
" 
   All #i #j x. Init_once(x)@i & Init_once(x)@j ==> #i=#j
"

restriction Neq:
"
    All x #i. Neq(x,x) @ i ==> F
"
#ifdef timethis
#endif
*/

end

