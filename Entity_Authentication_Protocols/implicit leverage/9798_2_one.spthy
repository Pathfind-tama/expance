theory ISO9798_2_one begin


builtins:diffie-hellman
/* 

 Protocol:

 1. A -> B: {ta}kab


*/
functions: enc/2, dec/2, know/3
equations: dec(enc(M,k), k) = M

rule setup:
  [ Fr(~k) ]
--[ KeyGen($A,$B) ]->
  [ !SharedKey($A, $B,~k) ]

/*
  rule reveal:
  [ !SharedKeyWithServer(X, k) ]
--[ Reveal(X,k),Init_once('1') ]->
  [ Out(k), Reveal(X,k)]
*/
rule AB1:
  [ Fr(~ta),!SharedKey($A, $B,kab)]
--[  ]->
  [ Out(enc(<<'g'^~ta,~ta>,$B>,kab))]



/*
rule Attack_test1:
    [ In(c),In(m),!SharedKey($A,$B,kab)]
  --[ Eq(c,enc(m,kab)),Attack_suc() ]->
    [ ]
*/
rule Guess_pw:
    [!SharedKey($A,$B,kab),Fr(~pw_guess)]
  --[Init_once('x')]->
    [Out(diff(~pw_guess,kab))]

rule RR:
    [In(<'g'^r,r>)]
  --[]->
    [Out('DF1')]

restriction Init:
" 
   All #i #j x. Init_once(x)@i & Init_once(x)@j ==> #i=#j
"

/*



restriction Verif:
"
    All x y #i. Eq(x,y) @ i ==> x = y
"*/



/*
restriction Neq:
"
    All x #i. Neq(x,x) @ i ==> F
"
#ifdef timethis
#endif
*/
/*
lemma Test:
exists-trace
"
  Ex #j. Attack_suc()@j
"*/

end

