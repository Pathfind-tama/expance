theory 9798two2 begin



/* 

 Protocol:

 1. A -> B: {ta}kab


*/
functions: enc/2[private], dec/2[private], prefix/1
equations: dec(enc(M,k), k) = M
         , prefix(enc(<X,Y>, k)) = enc(X, k)
//         , outfix(enc(<X,Y>, k)) = enc(Y, k)

rule setup:
  [ Fr(~k) ]
--[ KeyGen($A,$B) ]->
  [ !SharedKey($A, $B,~k) ]

/*
  rule reveal:
  [ !SharedKeyWithServer(X, k) ]
--[ Reveal(X,k),Init_once('1') ]->
  [ Out(k), Reveal(X,k)]
*/
rule BA1:
  [ Fr(~nb),!SharedKey($A, $B,kab)]
--[  ]->
  [ Out(~nb),BA1($A, $B,~nb)]

rule AB2:
let
	c=enc(<<~na,nb>,$B>,kab)
in
  [ In(nb),Fr(~na),!SharedKey($A, $B,kab)]
--[  ]->
  [ Out(c)]

rule BA3:
let
	m=dec(c,kab)
	nbs=snd(fst(m))
	na=fst(fst(m))
	c1=enc(<na,nb>,kab)
in
  [ In(c),BA1($A, $B,nb),!SharedKey($A, $B,kab)]
--[ Eq(nbs,nb) ,Run()]->
  [ Out(c1)]

rule Guess_pw:
    [!SharedKey($A,$B,kab),Fr(~pw_guess)]
  --[Init_once('x')]->
    [Out(diff(~pw_guess,kab))]
/*
rule RR:
    [In(<'g'^r,r>)]
  --[]->
    [Out('DF1')]*/

restriction Init:
" 
   All #i #j x. Init_once(x)@i & Init_once(x)@j ==> #i=#j
"
