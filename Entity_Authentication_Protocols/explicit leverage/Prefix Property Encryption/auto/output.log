  /* has exactly the trivial AC variant */

rule (modulo E) BA3:
   [ In( c ), BA1( $A, $B, nb ), !SharedKey( $A, $B, kab ) ]
  --[ Eq( snd(fst(dec(c, kab))), nb ), Run( ) ]->
   [ Out( enc(<nb, fst(fst(dec(c, kab)))>, kab) ) ]

